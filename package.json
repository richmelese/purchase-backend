{
  "name": "purchase-backend",
  "version": "1.0.0",
  "private": true,
  "description": "NestJS API for Purchase & Sales Management (private service behind the Next.js backend-for-frontend)",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "dev": "node scripts/dev.mjs",
    "test": "npm run build && node --test --test-concurrency=1 tests/*.test.mjs",
    "import": "npm run build && node dist/cli/import-workbook.js",
    "demo": "npm run build && node dist/cli/demo-data.js",
    "demo:remove": "npm run build && node dist/cli/demo-data.js --remove"
  },
  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {
    "@nestjs/common": "^12.1.2",
    "@nestjs/core": "^12.1.2",
    "@nestjs/platform-express": "^12.1.2",
    "cookie-parser": "^1.4.7",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.8",
    "@types/express": "^5.0.6",
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  }
}
