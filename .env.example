# Only needed when running the API on its own (npm run dev:backend). `npm run dev` at the
# project root starts both services and sets these for you.
PORT=5000
HOST=127.0.0.1

# SQLite file (default: ../data/psm.db, shared with the rest of the project)
# DATABASE_PATH=../data/psm.db

# Shared secret expected from the Next.js BFF (x-bff-secret header). Empty = accept any caller.
BFF_SHARED_SECRET=

# The browser never calls the API directly, so CORS is off. Set origins only for API tooling.
# CORS_ORIGIN=http://localhost:3000
